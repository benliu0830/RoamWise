{
  "name": "roamwise",
  "version": "0.1.0",
  "private": true,
  "description": "Travel discovery with real places and geographically planned itineraries.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:itinerary-browser": "node scripts/test-itinerary-browser.mjs",
    "test:live": "node scripts/test-live.mjs",
    "format": "prettier --write public/index.html public/css/*.css public/js/*.js api/*.js server/*.js scripts/*.mjs tests/*.js package.json vercel.json",
    "photos:ottawa": "node --env-file-if-exists=.env.local scripts/collect-ottawa-photos.mjs",
    "photos:paris": "node --env-file-if-exists=.env.local scripts/collect-paris-photos.mjs",
    "test:maps-history-browser": "node scripts/test-maps-history-browser.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10"
  }
}
