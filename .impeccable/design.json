      "css": ".ds-tag{font-family:Manrope,'Segoe UI',sans-serif;display:inline-block;background:var(--mint,#eaf2ef);border-radius:5px;padding:4px 9px;font-size:11px;color:var(--teal-dark,#1b514c);text-underline-offset:4px}.ds-tag:focus-visible{outline:3px solid #3d8880;outline-offset:4px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Active route and outlined saved control with a count.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a class=\"ds-active\" href=\"#tourist\">Tourist mode</a><a href=\"#local\">Local mode</a><a class=\"ds-saved\" href=\"#saved\">Saved <span class=\"ds-count\">2</span></a></nav>",
      "css": ".ds-nav{font-family:Manrope,'Segoe UI',sans-serif;display:flex;gap:30px;align-items:center;flex-wrap:wrap}.ds-nav a{text-decoration:none;font-size:14px;font-weight:600;color:var(--muted,#5c6b68);padding:9px 0;white-space:nowrap}.ds-nav a.ds-active{color:var(--teal,#246b64)}.ds-nav .ds-saved{border:1px solid var(--line,#dde4df);padding:10px 17px;border-radius:9px;display:flex;gap:9px;align-items:center}.ds-count{font-size:11px;background:var(--mint,#eaf2ef);color:var(--teal-dark,#1b514c);padding:0 6px;min-width:19px;border-radius:20px;text-align:center}.ds-nav a:focus-visible{outline:3px solid #3d8880;outline-offset:4px}"
    },
    {
      "name": "Place Card",
      "kind": "card",
      "refersTo": "place-card",
      "description": "Source surface, facts, and disclosure with its mint photo placeholder.",
      "html": "<article class=\"ds-card\"><div class=\"ds-photo\"><span class=\"ds-image-note\">Category inspiration photo ? not this place</span></div><div class=\"ds-card-body\"><div class=\"ds-category\">Nature ? outdoor</div><h3><a href=\"#place\">A place to explore</a></h3><p class=\"ds-description\">Discover a retrieved place and check its source details.</p><div class=\"ds-meta\"><strong>Entry cost: Not available</strong><span>Hours: Not available</span></div></div></article>",
      "css": ".ds-card{font-family:Manrope,'Segoe UI',sans-serif;max-width:340px;min-width:0;background:white;border-radius:var(--radius,14px);overflow:hidden;box-shadow:var(--shadow,0 8px 28px #203d2d0b);transition:transform .2s;color:var(--ink,#202d2c)}.ds-card:hover{transform:translateY(-3px)}.ds-photo{height:190px;position:relative;background:var(--mint,#eaf2ef)}.ds-image-note{position:absolute;bottom:0;left:0;right:0;padding:4px 10px;background:#142d23b8;color:#fff;font-size:11px}.ds-card-body{padding:19px}.ds-category{font-size:11px;color:var(--teal,#246b64);font-weight:700;margin-bottom:7px}.ds-card h3{margin:0;font-size:16px;font-weight:600;letter-spacing:-.02em;line-height:1.45;min-height:46px}.ds-card h3 a{color:inherit;text-decoration:none}.ds-description{font-size:11px;color:var(--muted,#5c6b68);margin:9px 0 0;line-height:1.8;min-height:40px}.ds-meta{margin-top:13px;padding-top:12px;border-top:1px solid var(--line,#dde4df);font-size:11px;display:flex;flex-direction:column;gap:5px;color:var(--muted,#5c6b68)}.ds-meta strong{color:var(--ink,#202d2c);font-weight:600}.ds-card a:focus-visible{outline:3px solid #3d8880;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}}"
    },
    {
      "name": "Itinerary Stop",
      "kind": "custom",
      "refersTo": "itinerary-stop",
      "description": "Tabular time and the source teal timeline point.",
      "html": "<div class=\"ds-schedule\"><div class=\"ds-time\">09:00</div><div class=\"ds-stop\"><h3><a href=\"#place\">First stop</a></h3><p>60 min suggested visit ? until 10:00</p><p class=\"ds-travel\">12 min estimated walk ? 0.8 km straight line</p></div></div>",
      "css": ".ds-schedule{font-family:Manrope,'Segoe UI',sans-serif;display:grid;grid-template-columns:55px 1fr;gap:14px;color:var(--ink,#202d2c)}.ds-time{font-size:12px;font-weight:700;padding-top:19px;font-variant-numeric:tabular-nums}.ds-stop{padding:18px 0 20px 20px;border-left:1px solid #bdd0c4;position:relative}.ds-stop:before{content:\"\";width:9px;height:9px;background:var(--teal,#246b64);border:4px solid var(--paper,#fafbf8);border-radius:50%;position:absolute;top:20px;left:-9px}.ds-stop h3{margin:0;font-size:17px;font-weight:600;letter-spacing:-.035em;line-height:1.12}.ds-stop h3 a{color:inherit;text-decoration:none}.ds-stop p{font-size:11px;color:var(--muted,#5c6b68);margin:8px 0 0}.ds-stop .ds-travel{color:var(--teal,#246b64);margin-top:12px}.ds-stop a:focus-visible{outline:3px solid #3d8880;outline-offset:4px}"
    }
  ],
  "narrative": {
    "northStar": "User-pinned premium light travel",
    "overview": "Roamwise follows the user's established white/off-white, charcoal, muted-teal travel direction. Airbnb and Google Travel are quality references: generous whitespace, elegant headings, destination photography, rounded cards, and restrained motion. The North Star above describes that established direction; it is not a new creative decision.\n\nLandscape imagery and quiet surfaces invite exploration, while structured labels keep search, place discovery, and itinerary planning understandable. The interface shares one restrained typography and component vocabulary across those tasks.",
    "keyCharacteristics": [
      "Light paper and white surfaces with charcoal text.",
      "Muted teal for actions, selection, and geographic cues.",
      "Self-hosted Manrope throughout.",
      "Photographic cards, subtle depth, and responsive grids.",
      "Explicit labels for inspiration imagery, missing facts, and estimates."
    ],
    "rules": [
      {
        "name": "The Meaningful Accent Rule",
        "body": "Use teal to identify actions, selection, and geographic cues while keeping reading surfaces light.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** retain the user's light surfaces, charcoal type, muted teal, destination imagery, and Manrope.",
      "**Do** reuse the existing card, control, spacing, and focus treatments when adding screens.",
      "**Do** keep inspiration-photo disclosures, unknown facts, and scheduling estimates visible.",
      "**Do** preserve responsive stacking and reduced-motion support."
    ],
    "donts": [
      "**Don't** introduce a different visual identity without user direction.",
      "**Don't** present category inspiration imagery as a photo of a retrieved place.",
      "**Don't** treat source/DOM checks as screenshot or real-device visual approval."
    ]
  },
  "verification": {
    "evidence": "CSS, HTML shell, and component markup inspected; source/DOM and live API passes reported by the implementation session.",
    "visual": "Not approved: browser automation bridge failed; no screenshots or real-device checks exist.",
