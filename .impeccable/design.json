      "refersTo": "field",
      "description": "Labeled travel input with source field and focus styles.",
      "html": "<label class=\"ds-field\">Destination<input placeholder=\"Where would you like to go?\"><small>Search by city or region.</small></label>",
      "css": ".ds-field{font-family:Manrope,'Segoe UI',sans-serif;display:flex;flex-direction:column;gap:7px;font-size:12px;font-weight:650;color:var(--ink,#202d2c)}.ds-field input{font-family:Manrope,'Segoe UI',sans-serif;background:#fcfdfb;border:1px solid #d5ded7;border-radius:7px;padding:11px 12px;color:var(--ink,#202d2c);font-size:14px;min-height:46px;min-width:0;caret-color:var(--teal,#246b64)}.ds-field input::placeholder{color:#6a7770}.ds-field input:focus-visible{outline:3px solid #3d8880;outline-offset:4px}.ds-field small{font-size:11px;font-weight:400;color:var(--muted,#5c6b68)}"
    },
    {
      "name": "Interest Choice",
      "kind": "chip",
      "refersTo": "choice",
      "description": "Native checkbox selection uses the implemented mint treatment.",
      "html": "<label class=\"ds-choice\"><input type=\"checkbox\" checked>Nature</label>",
      "css": ".ds-choice{font-family:Manrope,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line,#dde4df);border-radius:7px;padding:9px 12px;cursor:pointer;font-size:12px;background:white;color:var(--ink,#202d2c)}.ds-choice:has(input:checked){background:var(--mint,#eaf2ef);border-color:#89aaa0;color:var(--teal-dark,#1b514c)}.ds-choice input{margin:0;width:13px;height:13px;accent-color:var(--teal,#246b64)}.ds-choice input:focus-visible{outline:3px solid #3d8880;outline-offset:4px}"
