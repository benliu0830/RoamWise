    {
      "name": "Travel Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Source-derived component example; final responsive behavior is defined in public/css/styles.css.",
      "html": "<label class=\"ds-field\">Destination<input placeholder=\"Where would you like to go?\"><small>Search by city or region.</small></label>",
      "css": ".ds-field{font-family:Manrope,'Segoe UI',sans-serif;display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:650;color:var(--ink,#202d2c)}.ds-field input{font-family:Manrope,'Segoe UI',sans-serif;background:#fcfdfb;border:1px solid #d5ded7;border-radius:9px;padding:13px 14px;color:var(--ink,#202d2c);font-size:15px;min-height:52px;min-width:0;caret-color:var(--teal,#246b64)}.ds-field input::placeholder{color:#6a7770}.ds-field input:focus-visible{outline:3px solid #3d8880;outline-offset:4px}.ds-field small{font-size:11px;font-weight:400;color:var(--muted,#586963)}"
    },
    {
      "name": "Interest Choice",
      "kind": "chip",
      "refersTo": "choice",
      "description": "Source-derived component example; final responsive behavior is defined in public/css/styles.css.",
      "html": "<label class=\"ds-choice\"><input type=\"checkbox\" checked>Nature</label>",
      "css": ".ds-choice{font-family:Manrope,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line,#dce4dd);border-radius:7px;padding:9px 12px;cursor:pointer;font-size:12px;background:white;color:var(--ink,#202d2c)}.ds-choice:has(input:checked){background:var(--mint,#eaf2ef);border-color:#89aaa0;color:var(--teal-dark,#1b514c)}.ds-choice input{margin:0;width:13px;height:13px;accent-color:var(--teal,#246b64)}.ds-choice input:focus-visible{outline:3px solid #3d8880;outline-offset:4px}"
    },
    {
      "name": "Place Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Source-derived component example; final responsive behavior is defined in public/css/styles.css.",
      "html": "<a class=\"ds-tag\" href=\"#museum\">Museum alternative</a>",
      "css": ".ds-tag{font-family:Manrope,'Segoe UI',sans-serif;display:inline-block;background:var(--mint,#eaf2ef);border-radius:5px;padding:4px 9px;font-size:11px;color:var(--teal-dark,#1b514c);text-underline-offset:4px}.ds-tag:focus-visible{outline:3px solid #3d8880;outline-offset:4px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Source-derived component example; final responsive behavior is defined in public/css/styles.css.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a class=\"ds-active\" href=\"#tourist\">Tourist mode</a><a href=\"#local\">Local mode</a><a class=\"ds-saved\" href=\"#saved\">Saved <span class=\"ds-count\">2</span></a></nav>",
      "css": ".ds-nav{font-family:Manrope,'Segoe UI',sans-serif;display:flex;gap:30px;align-items:center;flex-wrap:wrap}.ds-nav a{text-decoration:none;font-size:14px;font-weight:600;color:var(--muted,#586963);padding:9px 0;white-space:nowrap}.ds-nav a.ds-active{color:var(--teal,#246b64)}.ds-nav .ds-saved{border:1px solid var(--line,#dce4dd);padding:10px 17px;border-radius:9px;display:flex;gap:9px;align-items:center}.ds-count{font-size:11px;background:var(--mint,#eaf2ef);color:var(--teal-dark,#1b514c);padding:0 6px;min-width:19px;border-radius:20px;text-align:center}.ds-nav a:focus-visible{outline:3px solid #3d8880;outline-offset:4px}"
    },
    {
      "name": "Place Card",
      "kind": "card",
      "refersTo": "place-card",
      "description": "Discovery card with category identity, image provenance, opening status, and detail action; no monetary fields.",
      "html": "<article class=\"ds-card\"><div class=\"ds-photo\"><span class=\"ds-image-note\">Category inspiration photo · not this place</span></div><div class=\"ds-card-body\"><span class=\"ds-category\">Nature &amp; parks</span><h3><a href=\"#place\">A place to explore</a></h3><p class=\"ds-description\">Discover a retrieved place and check its source details.</p><div class=\"ds-meta\"><span>Hours: Not available</span><span>0.8 km from your search center</span></div></div></article>",
      "css": ".ds-card{font-family:Manrope,'Segoe UI',sans-serif;max-width:340px;min-width:0;background:white;border-radius:var(--radius,16px);overflow:hidden;box-shadow:var(--shadow,0 12px 36px #203d2d0c);transition:transform .2s;color:var(--ink,#202d2c)}.ds-card:hover{transform:translateY(-2px)}.ds-photo{aspect-ratio:16/10;position:relative;background:var(--mint,#eaf2ef)}.ds-image-note{position:absolute;bottom:0;left:0;right:0;padding:4px 10px;background:#142d23b8;color:#fff;font-size:12px}.ds-card-body{padding:22px}.ds-category{display:inline-flex;padding:5px 9px;border-radius:6px;background:var(--category-nature-tint,#eaf5ed);color:var(--category-nature,#247941);font-size:11px;font-weight:700;line-height:1.5;margin-bottom:12px}.ds-card h3{margin:0;font-size:19px;font-weight:700;letter-spacing:-.025em;line-height:1.35}.ds-card h3 a{color:inherit;text-decoration:none}.ds-description{font-size:13px;color:var(--muted,#586963);margin:11px 0 0;line-height:1.7;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.ds-meta{margin-top:13px;padding-top:12px;border-top:1px solid var(--line,#dce4dd);font-size:12px;display:flex;flex-direction:column;gap:5px;color:var(--muted,#586963)}.ds-meta strong{color:var(--ink,#202d2c);font-weight:600}.ds-card a:focus-visible{outline:3px solid #3d8880;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}}"
    },
    {
      "name": "Itinerary Stop",
      "kind": "custom",
      "refersTo": "itinerary-stop",
      "description": "Source-derived component example; final responsive behavior is defined in public/css/styles.css.",
      "html": "<div class=\"ds-schedule\"><div class=\"ds-time\">09:00</div><div class=\"ds-stop\"><h3><a href=\"#place\">First stop</a></h3><p>60 min suggested visit ? until 10:00</p><p class=\"ds-travel\">12 min estimated walk ? 0.8 km straight line</p></div></div>",
      "css": ".ds-schedule{font-family:Manrope,'Segoe UI',sans-serif;display:grid;grid-template-columns:55px 1fr;gap:14px;color:var(--ink,#202d2c)}.ds-time{font-size:12px;font-weight:700;padding-top:19px;font-variant-numeric:tabular-nums}.ds-stop{padding:18px 0 20px 20px;border-left:1px solid #bdd0c4;position:relative}.ds-stop:before{content:\"\";width:9px;height:9px;background:var(--teal,#246b64);border:4px solid var(--paper,#f7f9f5);border-radius:50%;position:absolute;top:20px;left:-9px}.ds-stop h3{margin:0;font-size:17px;font-weight:600;letter-spacing:-.035em;line-height:1.12}.ds-stop h3 a{color:inherit;text-decoration:none}.ds-stop p{font-size:11px;color:var(--muted,#586963);margin:8px 0 0}.ds-stop .ds-travel{color:var(--teal,#246b64);margin-top:12px}.ds-stop a:focus-visible{outline:3px solid #3d8880;outline-offset:4px}"
    },
    {
      "name": "Category Chip",
      "kind": "chip",
      "refersTo": "category-chip",
      "description": "Visible discovery filter with a labeled category cue and pressed state.",
      "html": "<button class=\"ds-category-chip\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M20 4c-7-1-13 2-13 8a5 5 0 0 0 5 5c6 0 9-6 8-13Z\"/><path d=\"M4 21 16 9\"/></svg>Nature &amp; parks</button>",
