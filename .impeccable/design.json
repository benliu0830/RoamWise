      "html": "<article class=\"ds-branch-row\"><p class=\"ds-business\">Business name</p><h3>123 Example Street</h3><div class=\"ds-branch-meta\"><strong>0.8 km away</strong><span>Hours not available</span></div><a class=\"ds-branch-link\" href=\"#place\">View details</a></article>",
