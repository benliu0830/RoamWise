      "refersTo": "button-primary",
      "description": "Source-derived component example; final responsive behavior is defined in public/css/styles.css.",
      "html": "<button class=\"ds-button-primary\">Find my places</button>",
      "css": ".ds-button-primary{font-family:Manrope,'Segoe UI',sans-serif;font-size:15px;font-weight:650;line-height:1.6;border:0;border-radius:10px;padding:13px 22px;min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:11px;cursor:pointer;text-decoration:none;transition:background .18s,transform .18s;background:var(--teal,#246b64);color:white;}.ds-button-primary:hover{background:var(--teal-dark,#1b514c);transform:translateY(-1px)}.ds-button-primary:focus-visible{outline:3px solid #3d8880;outline-offset:4px}.ds-button-primary:disabled{cursor:wait;opacity:.65}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
