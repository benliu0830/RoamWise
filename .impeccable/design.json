      "html": "<button class=\"ds-button-secondary\">View details</button>",
      "css": ".ds-button-secondary{font-family:Manrope,'Segoe UI',sans-serif;font-size:15px;font-weight:650;line-height:1.6;border:0;border-radius:10px;padding:13px 22px;min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:11px;cursor:pointer;text-decoration:none;transition:background .18s,transform .18s;background:white;color:var(--ink,#202d2c);border:1px solid var(--line,#dce4dd);}.ds-button-secondary:hover{background:var(--mint,#eaf2ef);transform:translateY(-1px)}.ds-button-secondary:focus-visible{outline:3px solid #3d8880;outline-offset:4px}.ds-button-secondary:disabled{cursor:wait;opacity:.65}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
