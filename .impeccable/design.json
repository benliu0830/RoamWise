      "css": ".ds-button-quiet{font-family:Manrope,'Segoe UI',sans-serif;font-size:15px;font-weight:650;line-height:1.6;border:0;border-radius:8px;padding:13px 22px;display:inline-flex;align-items:center;justify-content:center;gap:11px;cursor:pointer;text-decoration:none;transition:background .18s,transform .18s;background:transparent;color:var(--teal,#246b64);padding-left:0;padding-right:0;}.ds-button-quiet:hover{background:transparent;transform:translateY(-1px)}.ds-button-quiet:focus-visible{outline:3px solid #3d8880;outline-offset:4px}.ds-button-quiet:disabled{cursor:wait;opacity:.65}@media(prefers-reduced-motion:reduce){.ds-button-quiet{transition:none}}"
